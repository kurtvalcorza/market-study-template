root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{ts,tsx,js,jsx,json}]
indent_style = space
indent_size = 2

[*.{md,qmd}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.tex]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
